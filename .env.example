# =============================================================================
# MaxKB Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values before running:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose --profile init up --abort-on-container-exit --exit-code-from maxkb-init maxkb-init
#   docker compose up -d
#
# IMPORTANT: .env is gitignored and should NEVER be committed to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Image Registry (optional, for China users)
# -----------------------------------------------------------------------------
# DOCKER_REGISTRY=docker.m.daocloud.io
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# -----------------------------------------------------------------------------
# HTTP Port Configuration
# -----------------------------------------------------------------------------
# The external port for accessing MaxKB web interface.
# Default: 18080
#
# IMPORTANT: Do NOT use port 10080 - it is blocked by Chromium-based browsers
# (Chrome, Edge, Brave, etc.) due to NAT Slipstreaming security concerns.
# See: https://chromium.googlesource.com/chromium/src.git/+/refs/heads/master/net/base/port_util.cc
#
# Safe alternatives: 80, 443, 8080, 8000, 3000, 5000, 18080
# -----------------------------------------------------------------------------
MAXKB_HTTP_PORT=18080

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
MAXKB_DB_NAME=maxkb
MAXKB_DB_HOST=postgres
MAXKB_DB_PORT=5432
MAXKB_DB_USER=maxkb
# CHANGE THIS: Use a strong, unique password
MAXKB_DB_PASSWORD=change_me_db_password
MAXKB_DB_ENGINE=dj_db_conn_pool.backends.postgresql
MAXKB_DB_MAX_OVERFLOW=80

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
MAXKB_REDIS_HOST=redis
MAXKB_REDIS_PORT=6379
# CHANGE THIS: Use a strong, unique password
MAXKB_REDIS_PASSWORD=change_me_redis_password
MAXKB_REDIS_DB=0
MAXKB_REDIS_MAX_CONNECTIONS=100

# -----------------------------------------------------------------------------
# Security Secrets (REQUIRED - No defaults)
# -----------------------------------------------------------------------------
# All of these MUST be set before first startup. Generate strong random values:
#   openssl rand -hex 32
#
# Django secret key for session signing, CSRF protection, etc.
MAXKB_SECRET_KEY=change_me_django_secret_key

# HMAC secret for Celery signed serializer
MAXKB_HMAC_SIGNED_SERIALIZER_SECRET_KEY=change_me_hmac_secret_key

# RSA key passphrase for encryption/decryption
MAXKB_RSA_PASSPHRASE=change_me_rsa_passphrase

# -----------------------------------------------------------------------------
# Bootstrap Admin Password (REQUIRED - No default)
# -----------------------------------------------------------------------------
# This is the initial password for the 'admin' user.
# There is NO default password - you MUST set this before first startup.
#
# After first login, MaxKB will require the admin to change this password.
#
# Generate a secure password:
#   openssl rand -base64 24
# -----------------------------------------------------------------------------
MAXKB_DEFAULT_PASSWORD=change_me_bootstrap_admin_password

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
MAXKB_CONFIG_TYPE=ENV
MAXKB_DEBUG=False
# REQUIRED for deployable runtimes: set the real hostnames or IPs that will
# serve MaxKB, for example: example.com,maxkb.internal,10.0.0.12
MAXKB_ALLOWED_HOSTS=example.com,127.0.0.1
MAXKB_LANGUAGE_CODE=zh-CN
MAXKB_TIME_ZONE=Asia/Shanghai

# Admin UI path (default: /admin)
# Access the admin interface at: http://your-host:MAXKB_HTTP_PORT/admin/
MAXKB_ADMIN_PATH=/admin

# -----------------------------------------------------------------------------
# Local Model Service (optional)
# -----------------------------------------------------------------------------
MAXKB_ENABLE_LOCAL_MODEL=False
MAXKB_LOCAL_MODEL_HOST=127.0.0.1
MAXKB_LOCAL_MODEL_PORT=11636
MAXKB_LOCAL_MODEL_PROTOCOL=http
MAXKB_LOCAL_MODEL_HOST_WORKER=1
